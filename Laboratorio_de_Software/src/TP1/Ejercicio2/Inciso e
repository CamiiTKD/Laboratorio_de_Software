   public class Alpha {
       protected int x;
       protected void otroMetodoA(){
           System.out.println(“Un método protegido”);
       }
   }

   package romano;
   import griego.*;
   public class Delta extends Alpha {
       void unMetodoD(Alpha a, Delta d){
           a.x=10;
           d.x=10;
           a.otroMetodoA();
           d.otroMetodoA();
       }
